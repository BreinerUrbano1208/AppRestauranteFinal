<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema oscuro premium con acento naranja. La app siempre se ve oscura. -->
    <style name="Base.Theme.AppRestaurante" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#111111</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFD84D</item>
        <item name="colorOnPrimaryContainer">#111111</item>
        <item name="colorSecondary">#8A6100</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#FFD84D</item>
        <item name="colorOnSecondaryContainer">#111111</item>
        <item name="colorTertiary">#FF6B4A</item>
        <item name="colorSurface">#F2F1ED</item>
        <item name="colorOnSurface">#111111</item>
        <item name="colorSurfaceVariant">#E9E7E0</item>
        <item name="colorOnSurfaceVariant">#6B6860</item>
        <item name="colorSurfaceContainerLowest">#FFFFFF</item>
        <item name="colorSurfaceContainerLow">#FFFFFF</item>
        <item name="colorSurfaceContainer">#FFFFFF</item>
        <item name="colorSurfaceContainerHigh">#FAF9F6</item>
        <item name="colorSurfaceContainerHighest">#ECEAE4</item>
        <item name="colorOutline">#9C9990</item>
        <item name="colorOutlineVariant">#E2E0D8</item>
        <item name="colorError">#E5484D</item>
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.Large</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="materialCardViewFilledStyle">@style/Widget.App.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNav</item>
        <item name="chipStyle">@style/Widget.App.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog</item>
        <item name="navigationViewStyle">@style/Widget.App.NavigationView</item>
        <item name="snackbarStyle">@style/Widget.App.Snackbar</item>
    </style>

    <style name="ShapeAppearance.App.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.App.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <style name="ShapeAppearance.App.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">34dp</item>
    </style>

    <style name="ShapeAppearance.App.Button" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="TextAppearance.App.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Botones: esquinas redondeadas, texto en negrilla -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button</item>
        <item name="android:textAppearance">@style/TextAppearance.App.Button</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Tarjetas: fondo suave con borde fino -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_nav_pill</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.NavLabel</item>
        <item name="itemIconTint">@color/nav_icon</item>
        <item name="itemTextColor">@color/nav_label</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.App.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimary</item>
        <item name="android:width">64dp</item>
        <item name="android:height">34dp</item>
    </style>

    <style name="TextAppearance.App.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Button</item>
        <item name="chipStrokeColor">?attr/colorOutlineVariant</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
    </style>

    <style name="ThemeOverlay.App.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Large</item>
        <item name="colorSurfaceContainerHigh">?attr/colorSurfaceContainerLow</item>
    </style>

    <style name="Widget.App.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="android:background">?attr/colorSurfaceContainerLow</item>
        <item name="itemTextColor">?attr/colorOnSurface</item>
        <item name="itemIconTint">?attr/colorOnSurface</item>
        <item name="itemShapeInsetStart">12dp</item>
        <item name="itemShapeInsetEnd">12dp</item>
        <item name="itemShapeFillColor">@color/drawer_item_bg</item>
        <item name="itemHorizontalPadding">20dp</item>
        <item name="itemIconPadding">16dp</item>
    </style>

    <style name="Widget.App.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="android:layout_margin">12dp</item>
    </style>

    <style name="Theme.AppRestaurante" parent="Base.Theme.AppRestaurante" />
</resources>
